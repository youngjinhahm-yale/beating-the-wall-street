# Copy to .env in this folder OR put it one folder up (the app checks both, this folder first).
# Never commit a real .env.

# AI key - one of these two. On the course key only gpt-6-luna is used.
PORTKEY_API_KEY=your-portkey-key-here
# OPENAI_API_KEY=your-openai-key-here

# Optional settings (defaults shown)
# DATA_MODE=sample          # sample = bundled data/sample.db (works offline), live = your own data/live.db
# SCHEDULER=off             # on = build rounds at 06:00 ET and settle at 16:15 ET automatically (default on in live mode)
# DAILY_TOKEN_CAP=600000    # all agents, per day (overspending circuit breaker)
# USER_DAILY_TOKEN_CAP=40000
# POST_THREAD_MIN_TIER=Gold # tier needed to start an insight thread
# ADMIN_USERNAMES=admin
# PORT=8000
